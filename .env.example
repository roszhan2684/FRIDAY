# FRIDAY Environment Variable Overrides
# Copy this file to .env and fill in your values.
# All values override config/friday.yaml

# ─── Murf TTS (required for neural voice) ────────────────────────────────────
MURF_API_KEY=your_murf_api_key_here
FRIDAY_MURF_VOICE_ID=en-US-matthew

# ─── Optional overrides ───────────────────────────────────────────────────────
# FRIDAY_DEBUG=true
# FRIDAY_OLLAMA_MODEL=llama3.1:8b
# FRIDAY_WHISPER_MODEL=mlx-community/whisper-large-v3-mlx
# FRIDAY_TTS_VOICE=Samantha
# FRIDAY_CONFIDENCE_THRESHOLD=0.70
