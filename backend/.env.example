# FRIDAY Backend Environment Variables
# Copy to .env and fill in values

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
FRIDAY_BACKEND_KEY=your-secret-api-key-here

# ─── Server ──────────────────────────────────────────────────────────────────
FRIDAY_BACKEND_PORT=7800
FRIDAY_BACKEND_DEBUG=false

# ─── Database ────────────────────────────────────────────────────────────────
# For local development (SQLite — no credentials needed):
DATABASE_URL=sqlite:///./friday_backend.db

# For production (Neon Postgres):
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/friday?sslmode=require

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_AUDIO=friday-audio
R2_BUCKET_DATASETS=friday-datasets
R2_BUCKET_MODELS=friday-models

# ─── User ────────────────────────────────────────────────────────────────────
FRIDAY_USER_ID=user_default
FRIDAY_USER_NAME=Boss
FRIDAY_USER_EMAIL=roszhan.2684@gmail.com
FRIDAY_USER_TIMEZONE=America/Los_Angeles
